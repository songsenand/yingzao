{
  "apiVersion": "checker/v1",
  "id": "fit-clearance",
  "version": "1.0.0",
  "row": "fit",
  "criteria": ["declared minimum clearance"],
  "entry": ["node", "check.mjs"],
  "permissions": ["read:constraints"],
  "timeoutMs": 5000,
  "negativeSamples": ["negative.json"],
  "config": { "minClearanceMm": 0.8, "measurementsFile": "measurements.json" },
  "description": "Template custom check: compare a measured clearance to a declared minimum. Copy to <project>/checks/ and replace measurements.json."
}
