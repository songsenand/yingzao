{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yingzao.local/schemas/library-catalog.schema.json",
  "title": "Yingzao standard-parts catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "library",
    "catalogVersion",
    "generatedAt",
    "units",
    "description",
    "packages",
    "families",
    "specs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "library": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "units": {
      "const": "mm"
    },
    "description": {
      "type": "string"
    },
    "dimensionPolicy": {
      "type": "string"
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "full"
      ],
      "properties": {
        "core": {
          "$ref": "#/$defs/package"
        },
        "full": {
          "$ref": "#/$defs/package"
        }
      }
    },
    "families": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/family"
      }
    },
    "specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spec"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSpecs",
        "status",
        "description"
      ],
      "properties": {
        "maxSpecs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "deprecated"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "standard",
        "category",
        "params",
        "fitRule",
        "visualRule",
        "datums",
        "compatibleWith",
        "defaultLod",
        "visualDefault",
        "source",
        "tags"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fitRule": {
          "type": "string",
          "minLength": 1
        },
        "visualRule": {
          "type": "string",
          "minLength": 1
        },
        "datums": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "compatibleWith": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "defaultLod": {
          "enum": [
            "fit",
            "visual"
          ]
        },
        "visualDefault": {
          "enum": [
            "distinct",
            "alias-fit"
          ]
        },
        "source": {
          "enum": [
            "purchased",
            "manufactured"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "spec",
        "standard",
        "package",
        "status",
        "source",
        "frequency",
        "lod",
        "params",
        "datums",
        "compatibleWith",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\..+$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "enum": [
            "core",
            "full"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "generated"
          ]
        },
        "source": {
          "enum": [
            "purchased",
            "manufactured"
          ]
        },
        "frequency": {
          "$ref": "#/$defs/frequency"
        },
        "lod": {
          "$ref": "#/$defs/lod"
        },
        "params": {
          "type": "object"
        },
        "datums": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "compatibleWith": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "score",
        "note"
      ],
      "properties": {
        "source": {
          "enum": [
            "assumed",
            "observed"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit",
        "visual"
      ],
      "properties": {
        "fit": {
          "$ref": "#/$defs/lodEntry"
        },
        "visual": {
          "allOf": [
            {
              "$ref": "#/$defs/lodEntry"
            },
            {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "distinct",
                    "alias-fit"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "lodEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "status",
        "model"
      ],
      "properties": {
        "role": {
          "enum": [
            "fit",
            "render"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "generated"
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/model"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "distinct",
            "alias-fit"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "stl",
        "stepSha256",
        "stlSha256"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "stl": {
          "type": "string",
          "minLength": 1
        },
        "stepSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stlSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
