      },
      "detail": "Thin walls run cold; 1.5mm is conservative for ADC12."
    },
    "featureMinMm": {
      "applies": true,
      "decidable": "geometry",
      "value": 1.0,
      "direction": "min",
      "source": {
        "kind": "rule-of-thumb",
        "ref": "die casting template"
      }
    },
    "gapMinMm": {
      "applies": true,
      "decidable": "geometry",
      "value": 0.5,
      "direction": "min",
      "source": {
        "kind": "rule-of-thumb",
        "ref": "die casting template"
      }
    },
    "overhangDeg": {
      "applies": false,
      "decidable": "geometry",
