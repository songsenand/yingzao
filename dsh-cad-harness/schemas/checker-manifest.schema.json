{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toymarker.local/schemas/checker-manifest.schema.json",
  "title": "checker/v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "version", "criteria", "entry", "permissions", "timeoutMs"],
  "properties": {
    "apiVersion": { "const": "checker/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
    "pearl": { "type": "string", "minLength": 1 },
    "row": { "enum": ["requirements", "model", "fit", "make", "review", "delivery"] },
    "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "entry": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "permissions": {
      "type": "array",
      "items": { "enum": ["read:geometry", "read:constraints", "write:artifacts"] }
    },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
    "negativeSamples": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "config": { "type": "object" },
    "description": { "type": "string" }
  }
}
