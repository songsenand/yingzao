{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toymarker.local/schemas/check-registry.schema.json",
  "title": "custom-check registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "history": { "type": "array", "items": { "$ref": "#/$defs/revoked" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "row", "criteria", "registeredAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "row": { "enum": ["requirements", "model", "fit", "make", "review", "delivery"] },
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "registeredAt": { "type": "string", "format": "date-time" }
      }
    },
    "revoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "registeredAt", "revokedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "revokedAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" }
      }
    }
  }
}
