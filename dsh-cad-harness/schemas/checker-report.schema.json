{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toymarker.local/schemas/checker-report.schema.json",
  "title": "checker/v1 report",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "checker", "status", "findings", "coverage", "artifacts"],
  "properties": {
    "apiVersion": { "const": "checker/v1" },
    "checker": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
    },
    "status": { "enum": ["pass", "fail", "blocked", "error"] },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "verdict"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["pass", "fail", "blocked", "error"] },
          "measured": { "type": "number" },
          "limit": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "witness": {
            "type": "object", "required": ["kind"],
            "properties": { "kind": { "type": "string", "minLength": 1 } },
            "additionalProperties": true
          },
          "attention": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": true,
              "required": ["kind", "note"],
              "properties": { "kind": { "type": "string" }, "note": { "type": "string" } }
            }
          },
          "message": { "type": "string" }
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["criteria", "complete", "skipped"],
      "properties": {
        "criteria": { "type": "array", "items": { "type": "string" } },
        "complete": { "type": "boolean" },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["criterion", "reason"],
            "properties": { "criterion": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string", "pattern": "^artifacts/" }
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "properties": { "ms": { "type": "number" } }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
