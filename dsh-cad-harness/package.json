{
  "name": "dsh-cad-harness",
  "description": "CAD harness: LLM-driven part and assembly design with a verification loop (OpenSCAD + Manifold compile/render; layered validation: geometry / rigid body / mechanism / MPM fluid), version store and human review channel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/cad/preset.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "external": ["@deepseek-ai/dsh-api-session-controller/client"]
    }
  },
  "files": [
    "lib/",
    "python/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.3",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "manifold-3d": "^3.5.3",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.3",
    "@types/node": "^26.6.2",
    "@types/react": "~18.3.1",
    "@types/three": "^0.186.0",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  }
}
