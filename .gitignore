# ---- 依赖与构建产物（可由源码 + lockfile 重建）----
node_modules/
dsh-cad-harness/lib/

# ---- 缓存 / 包商店 ----
.chrome-cache/
.pnpm-store/
.esbuild/

# ---- 第三方大文件（可重新获取）----
# OpenSCAD AppImage 及其解包
bin/
# vendored BOSL2 库（zip 可重下）
lib/
panel.bak.ts

# ---- 生成的工件（由语料 + 脚本再生）----
# 各 example 的版本库渲染输出（STL/PNG，由 scad 重新编译可再生）
examples/*/out/
# 项目内 CAD 语料（cad-data/：版本库 STL、运行帧——生成物；要版本管理可自行移出忽略）
cad-data/
examples/*/cad-data/
# 版本库生成的模型快照
dsh-cad-harness/data/versions/
# 截图与渲染输出
dsh-cad-harness/sandbox/shots/
/shots/
/renders/

# ---- 临时区 ----
verification/tmp/
*.log
.DS_Store
# 本地归档区：根目录散落物与 .tmp-* 探针残留的统一落点，可随时整体删除
/.local-archive/
# 根目录 .tmp/（与下面的 /.tmp-*/ 是两套命名，那条通配符不含它）
/.tmp/

# ---- 一次性扫描 / 探针脚本与输出 ----
/.tmp-*/
/.scan.mjs
# 插件内的临时运行时（venv 符号链接 + state.json 副本，供验收脚本在没有可写
# $DSH_HOME 时使用）；只在本机有意义，绝不入库
dsh-cad-harness/.tmp-*/

# ---- 验证截图（根 verification 与插件内 verification）----
verification/shots/
dsh-cad-harness/verification/shots/
# 插件内验证临时区（上方 verification/tmp/ 含斜杠只锚定仓库根，未命中此处）
dsh-cad-harness/verification/tmp/

# ---- preview 面板构建产物 ----
dsh-cad-harness/sandbox/preview/dist/

# ---- 运行时数据 ----
dsh-cad-harness/data/usage/
dsh-cad-harness/data/assembly/assembly-check-report.json

# ---- 评测基准（examples/bench/）----
# 结构：subjects/ = 考生侧（会话 cwd，只放工作区与题面要求它看的素材）
#       graders/  = 评分方（题面、rubric、答案；绝不进会话）
# 01b 的完整可跑语料由 tools/materialize-01b.mjs corpus 生成；
# 其 dossier/（JSON 证据子集，约 1.1MB）是入库的，正是它让该题自包含可移植
# （cad-data/ 已被上面的全局规则覆盖，无需重复）
examples/bench/subjects/*/assembly/
# 02 的导入件是生成物，不入库
examples/bench/subjects/02-steam-engine/assets/608.stl
# 每轮评测的打分输出（评分方侧）
examples/bench/graders/*/scores/
# 03 的原始参考图：**网络检索所得的照片 + AI 去水印**，非自有素材，权利不明。
# 2026-10-16 起判据图改为自绘（tools/make-reference-figure.py → graders/03-microscope/参考图.png）。
# 这张原图只留本地对照，**永不分发、永不入库**——AI 修改不清洗版权，衍生物同样不能发布。
/显微镜参考图.png

# ---- dsh home 本地实例（含凭据，禁止入库）----
examples/dsh-home/

# ---- Python 字节码（worker 的构建产物，禁止入库）----
__pycache__/
*.pyc

# ---- 调研与运行残留（一次性，可再生成）----
/.research/
/pypi_report.json
/assembly/

# ---- 本地项目：第三方模型版权未查清，整目录不入库（含 source/ 解包的 3MF）----
examples/rocket-3part/

# ---- 示例内的临时核对残留（verify/assembly 快照，可再生成）----
examples/*/.tmp/
