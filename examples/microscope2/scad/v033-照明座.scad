$fn=64;
// 照明座: 吊在载物台下面 (2×M3 从下方穿 U 型槽拧进载物台铜螺母)。
// Ø5 LED 沉孔 (LED 端面 z=205 → 到标本面 25mm, 滑槽 ±14 → 11..39mm = 调照明 NA)。
// 中间 Ø10 视场光阑 + 2mm 匀光片槽 (插描图纸/白 PET, 否则看到的是 LED 芯片的像)。
// 固定螺钉用 M3x35 (比 BOM 的 8/12/16 长): 头在 z=194, 尖到 229 才够到载物台铜螺母。
difference(){
  union(){
    translate([-52,46,176]) cube([104,28,32]);              // 主体 z176..208
  }
  // 2× U 型滑槽 (z 向 ±14)
  for(sx=[-1,1]) translate([sx*45-2.25,59,180]) cube([4.5,4,30]);
  // Ø5.1 LED 沉孔 (从底面往上, LED 端面停在 z=205)
  translate([0,60,175]) cylinder(d=5.1,h=31);
  // Ø10 视场光阑 + 光路
  translate([0,60,204.5]) cylinder(d=10,h=5);
  // 匀光片槽 2mm (局部切, 保证零件仍连成一体)
  translate([-24,52,205.5]) cube([48,16,2]);
}
// ---- datum anchors ----
datum("LED沉孔轴心",[0,60,230]);
datum("LED端面",[0,60,205]);
datum("照明座顶面",[0,60,208]);
datum("滑槽中心",[45,60,194]);
datum_cyl("LED沉孔",[0,60,190],[0,0,1],2.55);
datum_axis("照明轴",[0,60,200],[0,0,1]);
