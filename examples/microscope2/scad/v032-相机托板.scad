$fn=64;
// 相机托板: Ø23.2 塞进目镜筒同一个 Ø23.4 孔, 底面 = 传感器定位面 z=399 (= 像面)。
// 4×M3 螺柱托 PCB + 4×M3 调节螺钉 (补偿"传感器面到 PCB 面"未知量, ±1)。
// 注意: 裸板模块的传感器面到板面距离未知, 打印件给的是**基准面**, 落点靠垫片/调节钉。
module plate(){
  translate([0,60,399]) cylinder(d=23.2,h=25);       // 插入段 -> 424
  translate([40,40,424]) cube([40,40,4]);            // 法兰 40x40x4 -> 428
  for(p=[[-14,-14],[14,-14],[-14,14],[14,14]])
    translate([60+p[0],60+p[1],428]) cylinder(d=7,h=5);   // PCB 螺柱
}
difference(){
  plate();
  translate([0,60,398]) cylinder(d=12.2,h=36);       // 光路 Ø12.2
  for(p=[[-14,-14],[14,-14],[-14,14],[14,14]])
    translate([60+p[0],60+p[1],427]) cylinder(d=2.5,h=7);      // PCB M3 自攻孔
  for(p=[[-17,0],[17,0],[0,-17],[0,17]])
    translate([60+p[0],60+p[1],422]) cylinder(d=3.4,h=8);      // 4×M3 调节/固定通孔
}
// ---- datum anchors ----
datum("传感器定位面",[0,60,399]);
datum("托板法兰面",[0,60,428]);
datum("托板轴心",[0,60,410]);
datum_cyl("托板止口",[0,60,410],[0,0,1],11.6);
