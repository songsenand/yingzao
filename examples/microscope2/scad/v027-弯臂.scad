// 弯臂 v5: 立板直接顶到 z=352 与抱箍梁搭接, 去掉原来的"颈" ——
// 那个颈 (z318..354, y0..16) 正好卡在滑座前伸臂的上行路线里。
module body(){
  translate([-20,-30,212]) cube([40,44,16]);     // 底脚 y-30..14 z212..228
  translate([-15,-14,178]) cube([30,5,28]);      // 防转裙板下段 y-14..-9  z178..206
  translate([-15,-14,206]) cube([30,2.7,22]);    // 防转裙板上段 y-14..-11.3 z206..228
  translate([-22,-8,212])  cube([44,22,140]);    // 前立板 y-8..14 z212..352 (原到 320)
  translate([-14,12,348])  cube([28,48,27]);     // 抱箍梁 y12..60 z348..375
  translate([-26,34,355])  cube([52,52,20]);     // 抱箍座 y34..86 z355..375
}
module cuts(){
  translate([-16,2,205])  cube([32,6,111]);      // T 型内槽 y2..8 z205..316 (顶上被立板封住)
  translate([-6.7,8,205]) cube([13.4,6.3,111]);  // 槽口 y8..14.3 z205..316
  translate([0,60,335])   cylinder(d=34.3,h=60); // 抱箍内孔 Ø34.3
  translate([-1.5,34,354]) cube([3,10,22]);      // 抱箍开缝
  translate([-30,38,365]) rotate([0,90,0])  cylinder(d=3.4,h=60);
  translate([20.2,38,365]) rotate([0,90,0]) cylinder(d=4.2,h=6);
  for(sx=[-1,1]) translate([sx*18,8.3,265]) rotate([-90,0,0]) cylinder(d=4.2,h=6.4);
  for(sx=[-1,1]) translate([sx*15,8.3,217]) rotate([-90,0,0]) cylinder(d=4.2,h=6.4);
  for(p=[[7,0],[-7,0],[0,-7]]) translate([p[0],p[1],211]) cylinder(d=3.4,h=18);
}
difference(){ body(); cuts(); }
