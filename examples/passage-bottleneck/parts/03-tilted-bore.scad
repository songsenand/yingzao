// 03 斜孔 —— Ø8 通孔，轴线与 y 轴成 30°
//
// 真值：通道瓶颈半径 = 4.000mm。
//
// 用途：证明"通道轴"与"零件坐标轴"不重合**不构成问题**：
//       斜切一个棱柱通道得到的是拉长的椭圆/矩形，它的最大内切圆半径
//       仍等于正切时的半径。所以"换不同角度切"在棱柱通道上买不到任何东西。
$fn = 96;
difference() {
  cube([20, 20, 10], center = true);
  rotate([0, 0, 30]) rotate([-90, 0, 0]) cylinder(r = 4, h = 60, center = true);
}
