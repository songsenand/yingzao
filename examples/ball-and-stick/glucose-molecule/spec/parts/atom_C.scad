// 碳原子 C：四面体 4 孔（环上 5 个碳与 C6 共用此件）
// 球半径 R=8.6；定心平台在球面下 0.9mm；打印姿态：按本文件姿态（+Z 朝上）
$fn = 72;

// ---- socket（定心平台在 z=0，+Z 朝材料内部）----
module socket_cut(roofDeg = 0) {
  // 定心平台：自平台外侧切到 z=0
  translate([0, 0, -2]) cylinder(h = 2, r = 3.4, $fn = 72);
  // 直孔
  cylinder(h = 3.4, r = 2.6, $fn = 72);
  // 卡槽
  translate([0, 0, 2.15])
    cylinder(h = 0.9, r = 2.95, $fn = 72);
  // 泪滴排屑（朝"屋顶"偏心，让近水平孔的上壁不塌）
  rotate([0, 0, roofDeg])
    translate([2.85, 0, 0.5])
      cylinder(h = 2.9, r = 0.5, $fn = 72);
}

difference() {
  sphere(r = 8.6);
  // socket 轴 (0, 0, 1)
  translate([0, 0, 7.7])
    rotate(a = 180, v = [1, 0, 0])
      socket_cut(0);
  // socket 轴 (0, 0.9428, -0.3333)
  translate([0, 7.2596, -2.5667])
    rotate(a = 70.5288, v = [1, 0, 0])
      socket_cut(90);
  // socket 轴 (0.8165, -0.4714, -0.3333)
  translate([6.287, -3.6298, -2.5667])
    rotate(a = 70.5288, v = [-0.5, -0.866, 0])
      socket_cut(-30);
  // socket 轴 (-0.8165, -0.4714, -0.3333)
  translate([-6.287, -3.6298, -2.5667])
    rotate(a = 70.5288, v = [-0.5, 0.866, 0])
      socket_cut(-150);
}

datum_cyl("sock0", [0, 0, 7.7], [0, 0, 1], 2.6);
datum_cyl("sock1", [0, 7.2596, -2.5667], [0, 0.9428, -0.3333], 2.6);
datum_cyl("sock2", [6.287, -3.6298, -2.5667], [0.8165, -0.4714, -0.3333], 2.6);
datum_cyl("sock3", [-6.287, -3.6298, -2.5667], [-0.8165, -0.4714, -0.3333], 2.6);
