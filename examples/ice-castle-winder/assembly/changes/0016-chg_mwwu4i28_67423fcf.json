      "brief": {
        "buyVsMake": [
          {
            "item": "结构件/蜗杆/蜗轮/碟簧/销/卡簧",
            "decision": "make",
            "by": "user",
            "note": "用户要求无外购件"
          }
        ],
        "processes": [
          "fdm-pla-0.4"
        ],
        "processesBy": "user",
        "verify": [
          "assembly",
          "motion"
        ],
        "verifyBy": "user",
        "assumptions": [
          {
            "text": "整机包络约 226×204×248 mm（<=250，>=120）；最大单件 204 mm，适配 220×220×250 打印床",
            "by": "assumed"
          },
          {
            "text": "8 条线按 Ø2 mm 尼龙/棉线，单轮约 12–18 m；Ø1 mm 线约 30–45 m",
            "by": "assumed"
          },
          {
            "text": "单摇柄经双头蜗杆 10:1 同时收 8 轮；每轮由碟簧组 + 止推垫圈压紧的摩擦离合传递扭矩，拉线超扭矩时打滑",
            "by": "assumed"
          },
          {
            "text": "摩擦离合名义预紧 16–25 N、离合扭矩约 110–180 N·mm；碟簧自由高 6.5、安装 5.68，预紧未实测",
            "by": "assumed"
          },
          {
            "text": "运动仿真用规定传动比（蜗杆 10:1、8 轮 1:1），不模拟摩擦打滑与线张力",
            "by": "assumed"
          },
          {
            "text": "全部连接为打印榫/销/卡扣/销轴，无胶水、无螺钉、无轴承",
            "by": "user"
          }
        ]
      },
