  "acceptance": {
    "envelopeMm": {
      "tolerance": 2,
      "target": {
        "x": 227.99,
        "y": 184,
        "z": 45,
        "originMm": [
          0.006,
          0,
          0
        ]
      },
      "why": "两件都摆对时合起来的包络是唯一的。参考件自带插装件但都在两件内部，不改变包络；容差 ±2mm 用来吸收合并/坐标取整，摆错一个面会差出几十毫米，判据仍然敏感。"
    },
    "noInterference": {
      "why": "摆对了是\"贴合\"，摆错了十有八九是\"插进去\"——所以干涉数必须为 0。"
    },
    "bodiesAfterMerge": {
      "target": 1,
      "why": "两件装好后 `merge_parts` 应当得到**一个**连通体（它们本来就是靠配合特征连起来的）；若得到 2 体，说明两件根本没接触——位姿差得远。"
    }
  },
