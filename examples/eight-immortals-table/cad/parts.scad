$fn=40;

// ---- 桌腿 ----

module leg(){
  difference(){
    union(){
      translate([390.000,390.000,0.000]) cube([60.000,60.000,750.000]);
      translate([400.000,400.000,750.000]) cube([40.000,40.000,20.000]);
    }
    // 牙板透榫槽（沿 +x，+y 侧牙板 A 端穿入）
    translate([389.000,426.800,699.800]) cube([62.000,14.400,40.400]);
    // 牙板闷榫槽（沿 +y，+x 侧牙板 B 端）
    translate([426.800,389.000,699.800]) cube([14.400,23.200,40.400]);
  }
}

// ---- 边框 ----

module rail(){
  difference(){
    union(){
      translate([0,0,750]) linear_extrude(height=50) polygon(points=[[-370,370],[370,370],[450.0,450.0],[-450.0,450.0]]);
      translate([420.607,399.393,779.0]) rotate([0,0,-45]) cube([34,40,10],center=true);
    }
    // 面板槽：全长开通至 45° 端面（角部两框的槽合起来成 L 形）
    translate([-450.000,370.000,785.800]) cube([900.000,14.000,6.400]);
    // 腿顶榫卯（两端各半，合起来 40x40x20）
    translate([399.800,399.800,750.000]) cube([40.400,40.400,20.400]);
    translate([-440.200,399.800,750.000]) cube([40.400,40.400,20.400]);
    // 格角暗榫卯
    translate([-398.545,421.455,779.0]) rotate([0,0,45]) cube([34.4,40.4,10.4],center=true);
    // 竹销孔：+x 端穿暗榫，-x 端穿本体
    translate([418,384,750]) cylinder(h=34,r=4.0,$fn=40);
    translate([-384,418,750]) cylinder(h=34,r=4.0,$fn=40);
  }
}

// ---- 牙板 ----

module apron(){
  difference(){
    union(){
      translate([-390.000,424.000,680.000]) cube([780.000,20.000,70.000]);
      // A 端：透榫（390..460）
      translate([390.000,427.000,700.000]) cube([70.000,14.000,40.000]);
      // B 端：闷榫（-412..-390）
      translate([-412.000,427.000,700.000]) cube([22.000,14.000,40.000]);
    }
    hull(){ translate([375.000,423.500,680.000]) cube([15.000,21.000,0.200]); translate([389.800,423.500,680.000]) cube([0.200,21.000,15.000]); }
    hull(){ translate([-390.000,423.500,680.000]) cube([15.000,21.000,0.200]); translate([-390.000,423.500,680.000]) cube([0.200,21.000,15.000]); }
    // 透榫楔槽（横槽，撑开榫头上下两片）
    translate([428.000,426.900,718.400]) cube([32.200,14.200,3.200]);
  }
}

// ---- 面板-边板 ----

module panel_outer(){
  difference(){
    union(){
      translate([-365.000,-365.000,778.000]) cube([730.000,244.000,22.000]);
      translate([0,0,786]) linear_extrude(height=6) polygon(points=[[-379,-121],[-379,-377],[-377,-379],[377,-379],[379,-377],[379,-121],[365,-121],[365,-365],[-365,-365],[-365,-121]]);
    }
    // 内侧龙凤榫槽（向板内 8 深：y -129..-121）
    translate([-365.000,-129.000,785.800]) cube([730.000,8.000,6.400]);
    // 穿带燕尾槽
    hull(){ translate([-259.200,-365.000,778.000]) cube([30.400,244.000,0.100]); translate([-266.200,-365.000,783.900]) cube([44.400,244.000,0.100]); }
    hull(){ translate([-15.200,-365.000,778.000]) cube([30.400,244.000,0.100]); translate([-22.200,-365.000,783.900]) cube([44.400,244.000,0.100]); }
    hull(){ translate([228.800,-365.000,778.000]) cube([30.400,244.000,0.100]); translate([221.800,-365.000,783.900]) cube([44.400,244.000,0.100]); }
  }
}

