    hull(){ translate([-15.200,-121.000,778.000]) cube([30.400,242.000,0.100]); translate([-22.200,-121.000,783.900]) cube([44.400,242.000,0.100]); }
    hull(){ translate([228.800,-121.000,778.000]) cube([30.400,242.000,0.100]); translate([221.800,-121.000,783.900]) cube([44.400,242.000,0.100]); }
  }
}

// ---- 穿带 ----

module cleat(){
  union(){
    translate([-20.000,-363.000,752.000]) cube([40.000,726.000,26.000]);
    hull(){
      translate([-15.000,-363.000,777.900]) cube([30.000,726.000,0.050]);
      translate([-22.000,-363.000,783.800]) cube([44.000,726.000,0.100]);
    }
  }
}

