    "root": [
      {
        "path": "root.brief.assumptions",
        "before": [
          {
            "text": "按 1.5× 家用 15 类旋梭：梭芯 Ø30.4、旋梭外径 Ø45、钩尖轨迹 R22.5",
            "by": "user"
          },
          {
            "text": "冲压没有独立评估器：冲压件（连杆、梭壳定位指）按 sheet-metal-bend 档筛切割特征，模具/回弹/落料为 handoff",
            "by": "assumed"
          },
          {
            "text": "缝线路径不建模（线张力/成缝机理为 handoff）；运动只验钩尖-机针时序与干涉",
            "by": "assumed"
          },
          {
            "text": "齿轮为 PLA FDM；1:1 传动比另用 physics 轮齿接触 run 验证，motion run 直接驱动旋梭轴",
            "by": "assumed"
          },
          {
            "text": "轴承库件实测 Ø26×8（非 ISO 6000 的 Ø22），轴承座按库几何 Ø26",
            "by": "assumed"
          },
          {
            "text": "所有配合按名义尺寸留 0.1–0.5 mm 建模间隙，公差在接口里声明",
            "by": "assumed"
          }
        ],
        "after": [
          {
            "text": "市面缝纫机为两轴布局：针杆曲柄在上轴、旋梭在下轴，两轴由同步带（或立轴锥齿轮）保持 1:1 相位（专利 US20160289875A1/US6814015/US5125354）；本示例按两轴+GT2 带重做，用户 2026-11-22 批准",
            "by": "user"
          },
          {
            "text": "同步带轮 30T GT2 近似齿（外 r10.3），带 260mm；带为外购标准件，几何仅见证",
            "by": "assumed"
          },
          {
            "text": "上轴由两个 6000 轴承座（悬臂下挂）支承，后壁 Ø12 为过孔；手摇柄在上轴后端",
            "by": "assumed"
          },
          {
            "text": "冲压件（连杆、定位指）按 sheet-metal-bend 档筛切割特征，模具/回弹/落料为 handoff",
            "by": "assumed"
          },
          {
            "text": "缝线路径不建模；运动验针杆行程、钩尖-针眼时序与干涉",
            "by": "assumed"
          }
        ]
      },
