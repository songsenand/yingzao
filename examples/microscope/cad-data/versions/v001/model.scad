// ============================================================================
// 显微-底座 (microscope base)  · M1 骨架与高度链
// ----------------------------------------------------------------------------
// 坐标：世界坐标，z 向上，底面 z=0，底座中心在 (0,0)，立柱轴在 x=-40。
// 高度链（详见 ../README.md）：
//     标本面 z=155.0  --u=13.0-->  镜头座安装面 z=168.0
//                     --v=156.0--> 像面 z=324.0
//     抱箍座中心 z=256.0 = 168.0 + 88.0（镜筒 M3 必须遵守的 88 偏移）
//
// 本件职责（接口）：
//   if-1 立柱法兰面 ↔ 本件上表面        贴合, 0 ±0.20      → datum 法兰座面
//   if-3 立柱根部止口 Ø40 ↔ 本件法兰孔   紧固, 隙 0.15     → datum_cyl 法兰孔 Ø40.30
//
// 减料 / 配重：底面开 140×108×9 大腔（顶面留 3mm、周边留 5mm 壁），腔内保留
//   Ø64 立柱台墩（承止口孔与 4×M3 铜螺母）、四角 Ø18 垫脚柱、以及 3 条落地加强肋。
//   净空腔容积 ≈ 83 cm³ —— 既是打印减料（178→118.7 cm³），也是 M4 的配重腔：
//   填铅粒约 +380g，填不填由 M4 的 5° 斜面倾倒仿真回答。
//
// 打印：底面朝下，零支撑（3 条肋与周边壁、垫脚柱同时落地，顶皮只在 23mm 跨度上桥接）。
// ============================================================================

$fn = 64;

BASE_X = 150;   // PARAMS 底座长(X)
BASE_Y = 120;   // PARAMS 底座宽(Y)
BASE_Z = 12;    // PARAMS 底座厚(Z)

COL_X = -40;            // 立柱轴心 X（世界）
FLANGE_BORE_D = 40.30;  // PARAMS 立柱根部止口配合孔 Ø（止口 Ø40 → 单边 0.15）
FLANGE_BORE_H = 6;      // PARAMS 止口孔深（z 6..12，与立柱 spigot 等高）
FLANGE_BC_R = 25.5;     // PARAMS 立柱法兰螺孔分布圆半径（法兰 Ø60）
INSERT_D = 4.2;         // PARAMS 热熔铜螺母孔 Ø4.2
INSERT_H = 5.7;         // PARAMS 热熔铜螺母孔深 5.7

PEDESTAL_D = 64;        // 立柱台墩（保证铜螺母四周有料）
FOOT_D = 18;            // 四角垫脚柱
FOOT_X = 62; FOOT_Y = 48;
PAD_D = 14; PAD_H = 2;  // 橡胶垫位沉孔

CW_X = 140; CW_Y = 108; CW_H = 9;   // 底面减料腔 = 配重腔
CW_INSET = 5;                       // 周边壁厚（150/120 各留 5）

// 注意 OpenSCAD 求值顺序：台墩/垫脚柱整块都在底板内部，若先 union 再 difference，
// 它们对 union 的边界没有贡献、等于不存在。必须"先开腔，再把实体加回去"。
difference() {
  union() {
    // ---- 主板：先开出底面减料腔 / 配重腔 ----
    difference() {
      translate([-BASE_X / 2, -BASE_Y / 2, 0]) cube([BASE_X, BASE_Y, BASE_Z]);
      translate([-CW_X / 2, -CW_Y / 2, -0.01]) cube([CW_X, CW_Y, CW_H + 0.01]);
    }
    // ---- 立柱台墩（重新填实，保证止口孔与铜螺母四周有料）----
    translate([COL_X, 0, 0]) cylinder(d = PEDESTAL_D, h = BASE_Z);
    // ---- 四角垫脚柱（重新填实）----
    for (sx = [-1, 1], sy = [-1, 1])
      translate([sx * FOOT_X, sy * FOOT_Y, 0]) cylinder(d = FOOT_D, h = BASE_Z);
    // ---- 腔内加强肋 ×3（落地：底面朝下打印时零桥接；把顶皮跨距切成 3 段 23mm 桥）----
    for (ry = [-30, 0, 30])
      translate([-CW_X / 2, ry - 2, 0]) cube([CW_X, 4, CW_H]);
  }

  // ---- 立柱根部止口沉孔 Ø40.30（z 6..12）----
  translate([COL_X, 0, BASE_Z - FLANGE_BORE_H])
    cylinder(d = FLANGE_BORE_D, h = FLANGE_BORE_H + 1);

  // ---- 立柱法兰 4×M3 热熔铜螺母孔（Ø51 分布圆，45° 方位）----
  for (a = [45, 135, 225, 315])
    translate([COL_X + FLANGE_BC_R * cos(a), FLANGE_BC_R * sin(a), BASE_Z - INSERT_H])
      cylinder(d = INSERT_D, h = INSERT_H + 0.01);

  // ---- 四角橡胶垫位（底面沉孔 Ø14×2）----
  for (sx = [-1, 1], sy = [-1, 1])
    translate([sx * FOOT_X, sy * FOOT_Y, -0.01])
      cylinder(d = PAD_D, h = PAD_H + 0.01);
}

// ---------------------------------------------------------------------------
// datum 锚点（局部坐标 = 世界坐标：本件底面中心即原点，无装配变换）
// ---------------------------------------------------------------------------
datum("法兰座面", [COL_X, 0, BASE_Z]);            // if-1 本件端：立柱法兰落座面
datum_cyl("法兰孔", [COL_X, 0, BASE_Z - FLANGE_BORE_H / 2], [0, 0, 1], FLANGE_BORE_D / 2);  // if-3 本件端（孔）
datum("上表面_参考", [30, 0, BASE_Z]);
datum("底面中心", [0, 0, 0]);
datum("配重腔中心", [0, 0, CW_H / 2]);             // 配重腔体心（M4 用）
datum("垫位_前左", [-FOOT_X, -FOOT_Y, 0]);
datum_plane("上表面", [30, 0, BASE_Z], [0, 0, 1]);
