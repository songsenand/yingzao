// ============================================================================
// 显微-弯臂 (microscope arm)  · M1 骨架与高度链
// ----------------------------------------------------------------------------
// 局部坐标：原点 = 立柱轴心 ∩ 立柱顶面（世界 (-40,0,220)）；
//          装配变换 translate([-40, 0, 220])，故 局部 x = 世界 x + 40。
//   local x:  -18..108   水平梁（世界 -58..68，自立柱轴起悬伸 60 到 x=20，再前伸到 68）
//               9..20    防转裙板（世界 -31..-20，贴合立柱防转平面）
//              44..60    竖直导轨腿，前表面 x=60（世界 x=20）= M2 调焦导轨面
//              55..112   顶端抱箍座（世界 15..72，z 236..276）
//              镜筒轴 = local x 80（世界 x=40）
//   local z:  -63.87..16 导轨腿/裙板落到 z=-63.87（世界 156.13）—— 打印贴床面，
//                        并与载物台顶面 155.13 留出 1.0mm 让位间隙
//                 0..16   梁（世界 220..236）
//                16..56   抱箍座（世界 236..276，中心 = 世界 256.0）
//
// 高度链（本件承载"抱箍座高度"这个 datum）：
//     抱箍座中心 256.0 = 镜头座安装面 168.0 + 88.0
//     168.0 = 标本面 155.0 + 物距 u 13.0
//     324.0 = 168.0 + 像距 v 156.0
//   → M3 镜筒必须把"抱箍座面"做在"镜头座安装面"上方 88.0 处。
//
// 接口：if-2 弯臂底面↔立柱顶面(贴合 0)；if-4 竖直定位面↔立柱防转面(贴合 0)；
//       链自检 C1 镜头座安装面基准↔标本面 = 13.0；C2 像面基准↔安装面基准 = 156.0。
//
// 打印：导轨腿 + 裙板两条立墙落在 z=-63.87 平面，梁跨 24mm、尾端外伸 27mm
//       （≤30mm）。抱箍座悬伸在梁前段（Ø34.6 孔周围约 48×48）之下需少量支撑，
//       这是本件唯一需要支撑的位置，已记录在 README 的打印约束一节。
// ============================================================================

$fn = 64;

// ---- 世界高度链常量 ----
Z_SPECIMEN  = 155.0;   // 标本面（盖玻片上表面）
Z_MOUNT     = 168.0;   // 镜头座安装面 = 155.0 + 13.0
Z_IMAGE     = 324.0;   // 像面        = 168.0 + 156.0
Z_CLAMP     = 256.0;   // 抱箍座中心  = 168.0 + 88.0
CLAMP_OFF   = 88.0;    // 抱箍座中心 → 镜头座安装面（M3 镜筒契约）

X_TUBE      = 80;      // 镜筒轴 local（世界 x=40 = 通光孔轴 = 照明轴）
R_TUBE      = 17;      // 镜筒外半径 Ø34
R_BORE      = 17.3;    // 抱箍座内孔 Ø34.6（滑配单边 0.15）

BEAM_X0 = -18; BEAM_X1 = 108;   // 梁（世界 -58..68）
BEAM_H  = 16;
HALF_Y  = 24;                   // 梁/腿/裙板 宽 48
BOSS_HY = 20;                   // 抱箍座宽 40（减料；梁仍 48）

LEG_X0 = 48;  LEG_X1 = 60;      // 导轨腿 12 厚（世界 8..20，前表面仍是导轨面 x=20）
LEG_Z0 = 156.13 - 220;          // -63.87（世界 156.13）
SKIRT_X0 = 9; SKIRT_X1 = 17;    // 防转裙板 8 厚（世界 -31..-23，贴合面仍是 x=-31）

BOSS_X0 = 55; BOSS_X1 = 108;    // 抱箍座（世界 15..68）
BOSS_Z0 = 16; BOSS_Z1 = 56;     // 世界 236..276

POCKET_X0 = 18; POCKET_X1 = 44;   // 梁顶减料腔（避开裙板接头、立柱螺接区、抱箍座）
POCKET_HY = 18;

difference() {
  union() {
    // 水平梁
    translate([BEAM_X0, -HALF_Y, 0]) cube([BEAM_X1 - BEAM_X0, 2 * HALF_Y, BEAM_H]);
    // 竖直导轨腿（M2 滑座沿其前表面升降）
    translate([LEG_X0, -HALF_Y, LEG_Z0]) cube([LEG_X1 - LEG_X0, 2 * HALF_Y, BEAM_H - LEG_Z0]);
    // 防转裙板（竖直定位面贴立柱防转平面）
    translate([SKIRT_X0, -HALF_Y, LEG_Z0]) cube([SKIRT_X1 - SKIRT_X0, 2 * HALF_Y, -LEG_Z0]);
    // 顶端抱箍座
    translate([BOSS_X0, -BOSS_HY, BOSS_Z0]) cube([BOSS_X1 - BOSS_X0, 2 * BOSS_HY, BOSS_Z1 - BOSS_Z0]);
  }

  // ---- 梁底减料腔（留 3mm 顶皮 + 前后端实体）----
  translate([POCKET_X0, -POCKET_HY, 3])
    cube([POCKET_X1 - POCKET_X0, 2 * POCKET_HY, BEAM_H - 3 + 0.01]);

  // ---- 镜筒孔 Ø34.6：贯穿梁与抱箍座 ----
  translate([X_TUBE, 0, -1]) cylinder(d = 2 * R_BORE, h = BOSS_Z1 + 3);

  // ---- 抱箍开口缝（净宽 2.5，自前端面切到孔）----
  translate([LEG_X1, -1.25, BOSS_Z0]) cube([BOSS_X1 - LEG_X1 + 0.5, 2.5, BOSS_Z1 - BOSS_Z0 + 0.01]);

  // ---- 抱箍夹紧螺钉 M3（沿 Y 贯穿，世界 z=250）----
  translate([102, -BOSS_HY - 1, 46]) rotate([-90, 0, 0]) cylinder(d = 3.4, h = 2 * BOSS_HY + 2);

  // ---- 梁 ←→ 立柱顶面 2×M3 沉头孔（世界 x=-40, y=±6）----
  for (sy = [-6, 6]) {
    translate([0, sy, -0.5]) cylinder(d = 3.4, h = BEAM_H + 1);
    translate([0, sy, BEAM_H - 3]) cylinder(d = 6.2, h = 3.5);
  }

  // ---- 裙板 ←→ 立柱防转面 1×M3（沿 X 拧入，世界 z=210）----
  translate([SKIRT_X0 - 1, 0, -10]) rotate([0, 90, 0]) cylinder(d = 3.4, h = SKIRT_X1 - SKIRT_X0 + 2.5);
  translate([SKIRT_X1 - 3, 0, -10]) rotate([0, 90, 0]) cylinder(d = 6.2, h = 3.5);
}

// ---------------------------------------------------------------------------
// datum 锚点（局部坐标；装配变换 translate([-40,0,220])，注释给出世界值）
// ---------------------------------------------------------------------------
datum("弯臂底面", [0, 0, 0]);                              // if-2 → (-40,0,220)
datum("竖直定位面", [SKIRT_X0, 0, -10]);                   // if-4 → (-31,0,210)
datum("抱箍座中心", [X_TUBE, 0, 36]);                      // → (40,0,256)
datum("抱箍座底", [X_TUBE, 0, BOSS_Z0]);                   // → (40,0,236)
datum("镜头座安装面基准点", [X_TUBE, 0, Z_MOUNT - 220]);   // C1 → (40,0,168)
datum("标本面基准点", [X_TUBE, 0, Z_SPECIMEN - 220]);      // C1 → (40,0,155)
datum("像面基准点", [X_TUBE, 0, Z_IMAGE - 220]);           // C2 → (40,0,324)
datum("导轨面参考", [LEG_X1, 0, -40]);                     // → (20,0,180)

datum_plane("抱箍座安装面", [X_TUBE, 0, BOSS_Z0], [0, 0, 1]);
datum_plane("镜头座安装面基准", [X_TUBE, 0, Z_MOUNT - 220], [0, 0, 1]);
datum_plane("像面基准", [X_TUBE, 0, Z_IMAGE - 220], [0, 0, 1]);
datum_axis("镜筒轴", [X_TUBE, 0, LEG_Z0], [0, 0, 1]);
datum_plane("导轨面", [LEG_X1, 0, -40], [1, 0, 0]);
datum_cyl("抱箍座内孔", [X_TUBE, 0, 36], [0, 0, 1], R_BORE);
