// ============================================================================
// 显微-立柱 (microscope column)  · M1 骨架与高度链
// ----------------------------------------------------------------------------
// 局部坐标：原点 = 立柱轴心 ∩ 法兰底面（世界 z=12 平面）；装配变换
//          translate([-40, 0, 12])  →  立柱轴在世界 (x=-40, y=0)。
//   local z:  -6..0   根部止口 Ø40×6（插进底座 Ø40.30 沉孔）
//              0..8   法兰 Ø56×8（底面落座在底座上表面 z=12）
//              8..208 Ø22×200 柱身（世界 20..220）
//              144..208 防转平面（世界 156..220）：x>9 铣平，宽 12.6
//
// 本件职责（接口）：
//   if-1 法兰底面 ↔ 底座上表面      贴合 0        → datum 法兰底面
//   if-2 立柱顶面 ↔ 弯臂底面        贴合 0        → datum 立柱顶面
//   if-3 根部止口 Ø40 ↔ 底座 Ø40.30 紧固 隙 0.15  → datum_cyl 根部止口 r=20.0
//   if-4 防转平面 ↔ 弯臂竖直定位面   贴合 0        → datum 防转平面
//
// 打印：竖直打印（z 向上），零支撑。法兰底面 45° 倒锥（Ø48→Ø56）避免整圈水平
//       悬垂；柱身侧孔 Ø2.5 为水平小孔，可直接桥接。
// ============================================================================

$fn = 64;

COL_D      = 22;    // PARAMS 柱身直径
COL_H      = 200;   // PARAMS 柱身长度（法兰顶面到柱顶）
SPIGOT_D   = 39.5;    // PARAMS 根部止口 Ø40（与底座 Ø40.30 配合 → 隙 0.30）
SPIGOT_H   = 6;     // PARAMS 止口高（与底座沉孔等深）
FLANGE_D   = 60;    // PARAMS 法兰 Ø60（4×M3 落在 Ø51 分布圆上）
FLANGE_H   = 8;     // PARAMS 法兰高
FLANGE_BC_R = 25.5; // 4×M3 通孔分布圆半径
FLAT_X     = 9;     // PARAMS 防转平面到轴心距离（世界 x=-31）
FLAT_Z0    = 144;   // 防转平面下沿（世界 156，= 弯臂裙板下沿 -0.13）
FLAT_Z1    = 208;   // 防转平面上沿（世界 220 = 柱顶）

difference() {
  union() {
    // 根部止口 Ø40（z -6..0）
    translate([0, 0, -SPIGOT_H]) cylinder(d = SPIGOT_D, h = SPIGOT_H + 0.01);
    // 法兰：底部 45° 倒锥 Ø48→Ø60，再 Ø60 直段到 z=8
    cylinder(d1 = SPIGOT_D + 8, d2 = FLANGE_D, h = 4);
    translate([0, 0, 4]) cylinder(d = FLANGE_D, h = FLANGE_H - 4 + 0.01);
    // 柱身 Ø22（z 8..208；顶面取精确值 —— 弯臂梁就落在这一面上）
    translate([0, 0, FLANGE_H]) cylinder(d = COL_D, h = COL_H);
  }

  // 法兰 4×Ø3.4 通孔（45°、135°、225°、315°）
  for (a = [45, 135, 225, 315])
    translate([FLANGE_BC_R * cos(a), FLANGE_BC_R * sin(a), -SPIGOT_H - 1])
      cylinder(d = 3.4, h = FLANGE_H + SPIGOT_H + 2);

  // 防转平面：削掉 x > FLAT_X 的材料（世界 x > -31，z 156..220）
  translate([FLAT_X, -COL_D / 2 - 1, FLAT_Z0]) cube([COL_D, COL_D + 2, FLAT_Z1 - FLAT_Z0 + 0.01]);

  // 柱顶 2×M3 螺纹底孔 Ø2.5（弯臂梁从上方拧入），世界 z=220 向下 15
  for (sy = [-6, 6])
    translate([0, sy, FLAT_Z1 - 15]) cylinder(d = 2.5, h = 15.01);

  // 防转面上的 1×M3 螺纹底孔 Ø2.5（沿 -x 拧入，夹紧弯臂裙板），世界 z=210
  translate([-6, 0, 198]) rotate([0, 90, 0]) cylinder(d = 2.5, h = 15.01);
}

// ---------------------------------------------------------------------------
// datum 锚点（局部坐标；装配变换 translate([-40,0,12]) 后见注释中的世界值）
// ---------------------------------------------------------------------------
datum("法兰底面", [0, 0, 0]);                 // if-1 → 世界 (-40, 0, 12)
datum("立柱顶面", [0, 0, FLAT_Z1]);            // if-2 → 世界 (-40, 0, 220)
datum("防转平面", [FLAT_X, 0, 198]);           // if-4 → 世界 (-31, 0, 210)
datum_cyl("根部止口", [0, 0, -SPIGOT_H / 2], [0, 0, 1], SPIGOT_D / 2);   // if-3 → 世界 (-40,0,9)
datum_plane("防转面", [FLAT_X, 0, 176], [1, 0, 0]);
datum_plane("顶平面", [0, 0, FLAT_Z1], [0, 0, 1]);
datum_cyl("柱身外圆", [0, 0, 100], [0, 0, 1], COL_D / 2);
datum("柱身参考点", [0, 0, 100]);
