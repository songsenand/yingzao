// ============================================================================
// 显微-载物台 (microscope stage)  · M1 骨架与高度链
// ----------------------------------------------------------------------------
// 局部坐标：原点 = 镜筒轴 ∩ 台面上表面（世界 (40,0,155.13)）；
//          装配变换 translate([40, 0, 155.13])，故 局部 x = 世界 x - 40。
//   local x:  -19..91    台面 110×90×8（世界 21..131）
//             -90..-18   两条后支撑臂（y ±22..40，从台面后缘伸到立柱两侧）
//            -105..-55   Ø50 立柱抱箍（Ø22.6 孔，开缝 + M3 夹紧），世界 x -65..-15
//   local z:   -8..0     台体；玻片槽底面 z=-1.5（世界 153.63）
//   玻片槽：25.3(X) × 75.4(Y) × 1.5 深；通光孔 Ø12 贯穿。
//
// 光学高度（本件承载"标本面"这个 datum）：
//     标本面 = 槽底 153.63 + 载玻片 1.2 + 盖玻片 0.17 = 155.0
//     → 镜头座安装面 = 155.0 + 13.0 = 168.0（见弯臂的链自检 C1）
//
// 接口：if-5 槽壁A ↔ 槽壁B = 25.30（玻片槽宽）；if-3' 抱箍 Ø22.6 抱立柱 Ø22。
//   与弯臂的"故意不声明"邻近：抱箍上表面 155.13 ↔ 弯臂裙板下表面 156.13 = 1.0mm
//   让位间隙（清单里不写，看邻接发现是否抓出来）。
//
// 打印：整体平放，零支撑（板 + 抱箍 + 两条臂全在同一 8mm 厚度层内）。
// ============================================================================

$fn = 64;

Z_TOP       = 155.13;  // 台面上表面（世界 z）
DECK_X0     = -19; DECK_X1 = 91;    // 台面（世界 21..131）= 110
DECK_Y      = 90;                   // 台面宽
DECK_T      = 8;

GROOVE_W    = 25.30;   // PARAMS 玻片槽宽（载玻片 25 + 单边 0.15）
GROOVE_L    = 75.40;   // PARAMS 玻片槽长（载玻片 75 + 两端 0.20）
GROOVE_D    = 1.5;     // PARAMS 槽深（载玻片 1.2 落底）
LIGHT_D     = 12;      // PARAMS 通光孔 Ø12

COL_LOCAL_X = -80;     // 立柱轴 local（世界 -40）
COLLAR_D    = 50;      // 抱箍外径
COLLAR_BORE = 22.60;   // 抱箍孔 Ø22.6（立柱 Ø22 → 单边 0.15）

ARM_W_X0    = -90; ARM_W_X1 = -18;  // 后支撑臂（与台面搭接 1mm）
ARM_W_Y0    = 22;  ARM_W_Y1 = 40;

difference() {
  union() {
    // 台面
    translate([DECK_X0, -DECK_Y / 2, -DECK_T]) cube([DECK_X1 - DECK_X0, DECK_Y, DECK_T]);
    // 后支撑臂 ×2
    for (sy = [1, -1])
      translate([ARM_W_X0, sy > 0 ? ARM_W_Y0 : -ARM_W_Y1, -DECK_T])
        cube([ARM_W_X1 - ARM_W_X0, ARM_W_Y1 - ARM_W_Y0, DECK_T]);
    // 立柱抱箍
    translate([COL_LOCAL_X, 0, -DECK_T]) cylinder(d = COLLAR_D, h = DECK_T);
  }

  // ---- 玻片槽 25.3 × 75.4 × 1.5 ----
  translate([-GROOVE_W / 2, -GROOVE_L / 2, -GROOVE_D])
    cube([GROOVE_W, GROOVE_L, GROOVE_D + 0.01]);

  // ---- 通光孔 Ø12（贯穿台面）----
  translate([0, 0, -DECK_T - 0.5]) cylinder(d = LIGHT_D, h = DECK_T + 1);

  // ---- 抱箍孔 Ø22.6 ----
  translate([COL_LOCAL_X, 0, -DECK_T - 1]) cylinder(d = COLLAR_BORE, h = DECK_T + 2);

  // ---- 抱箍开缝（净宽 2.5，自后端切到孔心）----
  translate([-105, -1.25, -DECK_T - 1]) cube([25.01, 2.5, DECK_T + 2]);

  // ---- 抱箍夹紧螺钉 M3（沿 Y 贯穿，世界 z=151.13）----
  translate([-97, -COLLAR_D / 2 - 2, -DECK_T / 2]) rotate([-90, 0, 0]) cylinder(d = 3.4, h = COLLAR_D + 4);
}

// ---------------------------------------------------------------------------
// datum 锚点（局部坐标；装配变换 translate([40,0,155.13])）
// ---------------------------------------------------------------------------
datum("标本面", [0, 0, -0.13]);              // 槽底 153.63 + 1.2 + 0.17 → 世界 (40,0,155.0)
datum("槽底", [0, 30, -GROOVE_D]);           // → 世界 (40,30,153.63)
datum("槽壁A", [-GROOVE_W / 2, 0, -GROOVE_D / 2]);   // if-5 → 世界 (27.35,0,154.38)
datum("槽壁B", [GROOVE_W / 2, 0, -GROOVE_D / 2]);    // if-5 → 世界 (52.65,0,154.38)
datum("通光孔轴心", [0, 0, -DECK_T / 2]);     // → 世界 (40,0,151.13)
datum("台面点", [0, 0, 0]);                  // 与标本面同轴 → 世界 (40,0,155.13)
datum("后缘上角", [DECK_X0, 0, 0]);          // → 世界 (21,0,155.13)
datum("抱箍中心", [COL_LOCAL_X, 0, -DECK_T / 2]);    // → 世界 (-40,0,151.13)

datum_plane("台面", [0, 30, 0], [0, 0, 1]);
datum_plane("槽壁A面", [-GROOVE_W / 2, 0, -GROOVE_D / 2], [-1, 0, 0]);
datum_plane("槽壁B面", [GROOVE_W / 2, 0, -GROOVE_D / 2], [1, 0, 0]);
datum_cyl("通光孔", [0, 0, -DECK_T / 2], [0, 0, 1], LIGHT_D / 2);
datum_cyl("立柱抱孔", [COL_LOCAL_X, 0, -DECK_T / 2], [0, 0, 1], COLLAR_BORE / 2);
