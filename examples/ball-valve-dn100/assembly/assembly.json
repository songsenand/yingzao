    "brief": {
      "buyVsMake": [
        {
          "item": "紧固件（8×M16 中法兰、4×M10 压盖、1×M20 手柄锁紧螺母）与铭牌",
          "decision": "buy",
          "by": "user",
          "note": "用户确认按标准件外购；其余承压件与功能件全部自制"
        },
        {
          "item": "PTFE 棒料/板材（阀座、填料、中法兰垫片毛坯）",
          "decision": "buy",
          "by": "user",
          "note": "买材料不买零件，车削/切割在本项目内完成"
        },
        {
          "item": "阀体、端盖毛坯",
          "decision": "make",
          "by": "user",
          "note": "WCB 砂型铸造 + CNC 精加工"
        },
        {
          "item": "球体、阀杆、手柄毛坯",
          "decision": "make",
          "by": "user",
          "note": "2Cr13/钢模锻 + CNC"
        }
      ],
      "processes": [
        "sand-casting",
        "forging",
        "cnc-3axis",
        "cnc-turning"
      ],
      "processesBy": "user",
      "verify": [
        "assembly",
        "motion",
        "flow"
      ],
      "verifyBy": "user",
      "assumptions": [
        {
          "text": "介质为纯水；入口 2.0 m/s（≈56 m³/h）按 DN100 常用经济流速取，用户只指定了介质"
        },
        {
          "text": "结构取两片式/法兰/浮动球，面到面 229 mm（EN 558-1 series 14），管道法兰按 EN 1092-1 PN16 DN100（Ø220 / Ø180 / 8×Ø18 / RF Ø158×3）"
        },
        {
          "text": "球 Ø160 全通径、座孔 Ø104；密封面与球留 0.2 mm 预紧间隙（PTFE 受压变形未仿真）"
        },
        {
          "text": "中法兰 Ø236 大于管道法兰 Ø220：Ø160 球必须从 Ø164 开口装入，螺栓只能落在腔体之外"
        },
        {
          "text": "阀杆顶部 M20×1.5 螺纹与锁紧螺母未建几何（螺母为外购件）"
        },
        {
          "text": "铸造/锻造的拔模斜度与圆角未建在 CAD 里（由模具/砂型保证），工艺筛查会因此给出 draft 见证"
        },
        {
          "text": "手柄 400 mm；按 DN100 软密封操作扭矩约 130 N·m 计，手力约 325 N"
        },
        {
          "text": "流体仿真为固定边界 MPM：只给方向性证据（到达率/死区/速度剖面形状），不给压降或流量系数"
        }
      ]
    },
